<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><Nullable>enable</Nullable><ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>WindowsStickyNotes</AssemblyName><Version>1.4.3</Version><ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Notes.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><Content Include="Assets/Notes.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" /></ItemGroup>
  <ItemGroup><Content Include="Assets/google-oauth.json" Condition="Exists('Assets/google-oauth.json')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" /></ItemGroup>
  <ItemGroup><Compile Include="../.artifacts/GoogleDesktopClient.g.cs" Condition="Exists('../.artifacts/GoogleDesktopClient.g.cs')" /></ItemGroup>
</Project>
